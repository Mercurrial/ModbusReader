{
  "type": "object",
  "properties": {
    "format": {
      "const": "modbusreader.dashboard"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "widgets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "value",
              "led",
              "bar",
              "gauge",
              "bits",
              "chart",
              "button",
              "input",
              "toggle",
              "slider",
              "select",
              "timer",
              "gate",
              "label"
            ]
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "w": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "h": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "reg_id": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{4,5}$"
          },
          "reg_type": {
            "enum": [
              "BYTE",
              "BOOL",
              "SHORT",
              "UINT16",
              "BITS16",
              "BCD16",
              "LONG",
              "UINT32",
              "LONG1",
              "BCD32",
              "FLOAT",
              "FLOAT1",
              "FLOAT2",
              "INT64",
              "DOUBLE",
              "STRING",
              "ARR",
              "STR_LEN",
              "STR_PNTR",
              "MANY_STR",
              "DIBUS_ADR",
              "DATE_TIME",
              "UNUSED_AREA",
              "MEMORY_AREA"
            ]
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "vmin": {
            "type": "number"
          },
          "vmax": {
            "type": "number"
          },
          "thr": {
            "type": "number"
          },
          "invert": {
            "type": "boolean"
          },
          "alo": {
            "type": [
              "number",
              "null"
            ]
          },
          "ahi": {
            "type": [
              "number",
              "null"
            ]
          },
          "value_on": {
            "type": [
              "number",
              "string"
            ]
          },
          "value_off": {
            "type": [
              "number",
              "string"
            ]
          },
          "interval": {
            "type": "integer",
            "minimum": 50,
            "maximum": 2147483647
          },
          "autostart": {
            "type": "boolean"
          },
          "cond": {
            "enum": [
              "gt",
              "ge",
              "lt",
              "le",
              "eq",
              "ne"
            ]
          },
          "cmp": {
            "type": "number"
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "live": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "required": [
          "uid",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "version",
    "widgets",
    "links"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModbusReader dashboard authoring contract"
}
